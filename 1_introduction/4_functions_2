#Fitting function to experimental data - obtaing best values for a, b, c and d parameters

set table
set output "data_4/fit_results"

a=0.25
b=0.02
c=0.05
d=0.1
f(x)=c/((x-a)**2+b)+d/sqrt(x)

set xlabel "Energy [MeV]"
set ylabel "Cross section [b]"
set xrange [0:1]
set yrange [0:4]
set xtics 1
set ytics 0.5


plot f(x) title "Lorentzian", "data_4/exp.dat" using 1:2:3 title "experiment" with yerrorbars

fit f(x) "data_4/exp.dat" using 1:2:3 via a,b,c,d

pause -1


